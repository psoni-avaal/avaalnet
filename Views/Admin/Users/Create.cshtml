@{
    ViewData["Title"] = "Create User";
}

<main class="admin-management-page">
    <a asp-controller="Admin" asp-action="Users" class="qb-back-link">← Back to User List</a>
    <header class="checkout-heading">
        <span class="eyebrow">NEW USER</span>
        <h1>Create New User</h1>
        <p>Add a new user to the QuickBasket system.</p>
    </header>

    <form asp-controller="Admin" asp-action="Users/AddUser" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-field">
            <label asp-for="Name">Full name</label>
            <input asp-for="Name" autocomplete="name" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Email">Email address</label>
            <input asp-for="Email" type="email" autocomplete="email" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" autocomplete="new-password" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Address">Delivery address</label>
            <textarea asp-for="Address" rows="3" autocomplete="street-address" placeholder="House number, street, city, postal code"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary account-submit">Create User</button>
    </form>
</main>