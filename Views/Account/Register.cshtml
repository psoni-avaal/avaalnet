@model BasicDotNetPostgresWebsite.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create account";
}

<main class="account-page">
    <a asp-controller="Home" asp-action="Index" class="qb-brand account-brand">
        <a asp-controller="Admin" asp-action="Index" class="qb-admin-link">Admin Portal</a>
    </a>

    <section class="account-card">
        <span class="account-kicker">A BETTER WAY TO SHOP</span>
        <h1>Create your account</h1>
        <p>Save your delivery details and keep checkout simple.</p>

        <form asp-action="Register" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="account-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-field">
                <label asp-for="Name">Full name</label>
                <input asp-for="Name" autocomplete="name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" type="email" autocomplete="email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Address">Delivery address</label>
                <textarea asp-for="Address" rows="3" autocomplete="street-address" placeholder="House number, street, city, postal code"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" autocomplete="new-password" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary account-submit">Create account</button>
        </form>

        <div class="account-switch">Already have an account? <a asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">Sign in</a></div>
    </section>
</main>